# Optional overrides. Defaults in docker-compose.yml are local-only; copy to .env to change them.
# Don't use single quotes in passwords (Flyway pastes them into SQL).
FP_PG_PASSWORD=fleetpulse-local
FP_APP_PASSWORD=fleetpulse-app-local
FP_API_PASSWORD=fleetpulse-api-local
FP_RO_PASSWORD=fleetpulse-ro-local
# Only used with compose.debug.yml
FP_DEBUG_API_PORT=8084
FP_DEBUG_SIM_PORT=8082
FP_DEBUG_SINK_PORT=8083
# Simulator passthrough; commented values are the defaults. Empty SIM_EPOCH = boot time, pin it for repeatable event ids.
# SIM_SEED=42
# SIM_EPOCH=
# SIM_HEARTBEAT_INTERVAL=2s
# SIM_TELEMETRY_INTERVAL=2s
# SIM_BUFFER_CAPACITY=400
# SIM_MAX_SEND_RATE=2000
# Processor retention (defaults shown)
# FP_RETENTION_INBOX=30m
# FP_RETENTION_TELEMETRY=15m
# FP_RETENTION_LATE=1h
# FP_RETENTION_INTERVAL=60s
# Processor alerting and webhook (defaults shown)
# FP_OFFLINE_TIMEOUT=10s
# FP_SWEEP_INTERVAL=1s
# FP_SWEEP_MAX_LAG=1000
# FP_SWEEP_GRACE=10s
# FP_WEBHOOK_TIMEOUT=5s
# FP_WEBHOOK_MAX_ATTEMPTS=20
# FP_WEBHOOK_BACKOFF_BASE=1s
# FP_WEBHOOK_BACKOFF_MAX=30s
# FP_WEBHOOK_JITTER=0.2
# FP_WEBHOOK_CONCURRENCY=10
# FP_OUTBOX_POLL_INTERVAL=250ms
# FP_RETENTION_HISTORY=7d
# FP_RETENTION_ALERTS=7d
# FP_RETENTION_OUTBOX_DELIVERED=24h
# Sink
# FP_PAYLOAD_LIMIT=10000
